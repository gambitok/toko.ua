
DirectoryIndex index.php
Options -Indexes
IndexOptions -FancyIndexing
AddDefaultCharset utf-8

Options +FollowSymLinks
RewriteEngine On
php_value error_reporting 1

ErrorDocument 404 /404.php

##redirect http://www.toko.ua/catalog/akkumuljatornye-batarei/?page=2 => https://toko.ua/catalog/akkumuljatornye-batarei/?page=2
#RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
#RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

# ----------------------------------------------------------------------
# Add a trailing slash to paths without an extension
# ----------------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ $1/ [L,R=301]

## redirect https://toko.ua/index => https://toko.ua
#RewriteCond %{THE_REQUEST} ^.*/index
#RewriteRule ^(.*)$ https://toko.ua/ [R=301,L]

# redirect https://toko.ua/index.php => https://toko.ua
RewriteCond %{THE_REQUEST} ^.*/index\.php
RewriteRule ^(.*)index.php$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} ^.*/home\.php
RewriteRule ^(.*)home.php$ /$1 [R=301,L]

# redirect https://toko.ua/index.html => https://toko.ua
RewriteCond %{THE_REQUEST} ^.*/index\.html
RewriteRule ^(.*)index.html /$1 [R=301,L]
RewriteCond %{THE_REQUEST} ^.*/home\.html
RewriteRule ^(.*)home.html /$1 [R=301,L]

# redirect https://toko.ua/index.htm => https://toko.ua
RewriteCond %{THE_REQUEST} ^.*/index\.htm
RewriteRule ^(.*)index.htm /$1 [R=301,L]
RewriteCond %{THE_REQUEST} ^.*/home\.htm
RewriteRule ^(.*)home.htm /$1 [R=301,L]

# redirect https://toko.ua//// or https://toko.ua//catalog/ => https://toko.ua
RewriteCond %{THE_REQUEST} \s/+(.*?)/{2,}([^\s]*)
RewriteRule ^ %1/%2 [R=301,L,NE]

## redirect https://toko.ua/catalog/shrus?page=0 => https://toko.ua/catalog/shrus
RewriteCond %{QUERY_STRING} page=0$ [NC]
RewriteRule ^.*$ https://%{SERVER_NAME}%{REQUEST_URI}? [L,R=301]
## redirect https://toko.ua/catalog/shrus?page=1 => https://toko.ua/catalog/shrus
RewriteCond %{QUERY_STRING} page=1$ [NC]
RewriteRule ^.*$ https://%{SERVER_NAME}%{REQUEST_URI}? [L,R=301]

# add slash in end
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*[^/])$ $1/ [L,R=301]

### START WWW & HTTPS
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteBase /
RewriteCond %{HTTP_HOST} ^www.localhost:8080
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
RewriteRule ^index\.php$ https://www.localhost:8080/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^(.*)(/?)+$ /?link=$1&%{QUERY_STRING} [NC,L]

### GZIP
<IfModule mod_deflate.c>
    #The following line is enough for .js and .css
    AddOutputFilter DEFLATE js css
    #The following line also enables compression by file content type, for the following list of Content-Type:s
    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml
    #The following lines are to avoid bugs with some browsers
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

<IfModule mod_headers.c>
    Header always append X-Frame-Options SAMEORIGIN
    <FilesMatch "\.(js|css|xml|gz)$">
        Header append Vary: Accept-Encoding
    </FilesMatch>
</IfModule>

### CASH FILES
<ifModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 days"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/jpeg "access plus 4 weeks"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 43829 minutes"
    ExpiresByType application/x-shockwave-flash "access plus 2592000 seconds"
    ExpiresByType text/css "access plus 604800 seconds"
    ExpiresByType text/javascript "access plus 604800 seconds"
    ExpiresByType application/javascript "access plus 604800 seconds"
    ExpiresByType application/x-javascript "access plus 604800 seconds"
    ExpiresByType text/html "access plus 43200 seconds"
    ExpiresByType application/xhtml+xml "access plus 600 seconds"
    ExpiresByType application/x-font-ttf "access plus 1 month"
    ExpiresByType font/opentype "access plus 1 month"
    ExpiresByType application/x-font-woff "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
</ifModule>
<FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf)$">
    Header set Cache-Control "max-age=604800, public"
</FilesMatch>
